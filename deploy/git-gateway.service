[Unit]
Description=git-gateway (Zero-Permission Crowdsourcing Patch Proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=git-gateway
Group=git-gateway
WorkingDirectory=/opt/git-gateway
EnvironmentFile=/etc/git-gateway/env
Environment=PYTHONUNBUFFERED=1
Environment=CONTENT_DIR=/var/lib/git-gateway/content
ExecStart=/opt/git-gateway/.venv/bin/python /opt/git-gateway/main.py
Restart=on-failure
RestartSec=3

# Admin prompt/TODO 持久化目录：StateDirectory 会在 ProtectSystem=strict 下
# 自动创建该目录并授予本服务读写权限（属主为本服务用户）
StateDirectory=git-gateway
StateDirectoryMode=0750

# 安全加固：根文件系统只读，仅允许写入 StateDirectory 与私有 /tmp
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
