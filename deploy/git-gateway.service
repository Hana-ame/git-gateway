[Unit]
Description=git-gateway (Zero-Permission Crowdsourcing Patch Proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=git-gateway
Group=git-gateway
WorkingDirectory=/opt/git-gateway
EnvironmentFile=/etc/git-gateway/env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/git-gateway/.venv/bin/python /opt/git-gateway/main.py
Restart=on-failure
RestartSec=3

# 安全加固：根文件系统只读，仅允许写入私有 /tmp（零本地持久化目录）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
