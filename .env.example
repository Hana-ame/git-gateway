# ============================================================
# git-gateway 环境变量配置模板
# 复制为 .env (Docker / 本地运行) 或 /etc/git-gateway/env (systemd)
# ============================================================

# ---------- GitHub 认证（默认使用 `gh` CLI 管理） ----------
# 推荐直接执行 `gh auth login` 登录，网关启动时自动调用 `gh auth token` 并缓存。
# 仅在无法使用 gh CLI 时，才取消下方注释显式覆盖：
# GITHUB_TOKEN=ghp_replace_with_your_github_token
USE_GH_CLI=true

# Docker 挂载宿主机 gh 配置目录路径（默认 ~/.config/gh）
# GH_HOST_CONFIG_DIR=~/.config/gh

# ---------- 管理员接口鉴权密钥（建议 openssl rand -hex 32 生成） ----------
ADMIN_TOKEN=replace_with_strong_random_secret

# ---------- 白名单 / 黑名单规则文件（gitignore 风格，支持热重载） ----------
REPO_RULES_FILE=./repos.txt

# 兼容 v1 的旧写法（可选）：仅当 REPO_RULES_FILE 未设置时生效
# 逗号分隔的 owner/repo 列表，逐项转为 allow 规则
# ALLOWED_REPOS=Hana-ame/repo

# ---------- 常用配置 ----------
# 对外访问的完整基础 URL（生产环境强烈建议显式填写，防止 Host 头伪造）
PUBLIC_BASE_URL=https://proxy.com

# 若前面有可信 Nginx/Caddy 反代且未设置 PUBLIC_BASE_URL，可设为 true
TRUST_PROXY_HEADERS=false

# 自定义路径别名映射（可选，留空则直接用 /<owner>/<repo> 访问）
REPO_ALIASES=

# 默认基准分支
DEFAULT_BASE_BRANCH=main

# GitHub 站点地址（可选，默认 github.com；GitHub Enterprise Server 需改）
# GITHUB_WEB_BASE=https://github.com

# GitHub API 地址（可选，默认 api.github.com；GHES 需改成 https://ghe.example.com/api/v3）
# GITHUB_API_BASE=https://api.github.com

# ---------- 网络与端口 ----------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
BIND_HOST=0.0.0.0

# ---------- 安全与限制（可选） ----------
ALLOW_SYMLINK_PATCHES=false
MAX_PATCH_BYTES=10485760
MAX_GIT_PROXY_BODY_BYTES=2097152
MAX_LOG_BYTES=5242880
GIT_TIMEOUT_SECONDS=120

# 禁止 Patch 修改的路径（不填则用默认值，拦截 CI 配置等敏感目录）
# 逗号分隔；设为 none 表示完全不拦截（不推荐）
# BLOCKED_PATCH_PATHS=.github/workflows/*,.github/workflows/**,.github/actions/*,.github/actions/**

# ---------- 临时文件目录（可选） ----------
# 所有 bare clone / worktree / patch 文件都落在这里，请求结束立即删除（零本地持久化）
# 不填则用系统临时目录：/tmp/git-gateway (Linux/macOS) 或 %TEMP%\git-gateway (Windows)
# TEMP_DIR=/tmp/git-gateway

# ---------- Admin 内容持久化目录（重要） ----------
# Admin 通过 API 下发的 prompt/TODO 是配置数据，落盘后才能跨重启保留。
# 不填 => 仅存进程内存，重启/重建后回到内置默认模板（可用 /health 的 content_store.mode 确认）。
# Docker Compose 与 systemd unit 均已显式设置该变量，通常无需在此重复配置：
#   Docker:  /var/lib/git-gateway/content（命名卷 git-gateway-data）
#   systemd: /var/lib/git-gateway/content（StateDirectory=git-gateway）
# 本地开发留空即可；如需本地验证持久化，取消下面注释并指向可写目录：
# CONTENT_DIR=./data/content
