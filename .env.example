# ============================================================
# git-gateway 环境变量配置模板
# 复制为 .env (Docker / 本地运行) 或 /etc/git-gateway/env (systemd)
# 注意：包含敏感 Token，请务必设置权限 chmod 600
# ============================================================

# ---------- 必填项 ----------
# GitHub Personal Access Token (需 repo + actions:read 权限)
GITHUB_TOKEN=ghp_replace_with_your_github_token

# 管理员接口鉴权密钥（建议用 openssl rand -hex 32 生成）
ADMIN_TOKEN=replace_with_strong_random_secret

# ---------- 白名单 / 黑名单规则文件（gitignore 风格，支持热重载） ----------
REPO_RULES_FILE=./repos.txt

# 兼容 v1 的旧写法（可选）：REPO_RULES_FILE 未设置时才生效
# 逗号分隔的 owner/repo 列表，逐项转为 allow 规则；留空则回落到 ./repos.txt
# ALLOWED_REPOS=Hana-ame/repo

# ---------- 常用配置 ----------
# 对外访问的完整基础 URL（反向代理后建议显式填写，不要带末尾斜杠）
PUBLIC_BASE_URL=https://proxy.com

# 自定义路径别名映射（可选，留空则直接用 /<owner>/<repo> 访问）
# 格式: 公开路径=owner/repo（多个用逗号分隔）
REPO_ALIASES=

# 默认基准分支（提交 Patch 未指定 base_branch 时生效）
DEFAULT_BASE_BRANCH=main

# GitHub 站点地址（可选，默认 github.com；GitHub Enterprise Server 需改成 https://ghe.example.com）
# GITHUB_WEB_BASE=https://github.com

# GitHub API 地址（可选，默认 api.github.com；GHES 需改成 https://ghe.example.com/api/v3）
# GITHUB_API_BASE=https://api.github.com

# ---------- 网络与端口 ----------
# 服务监听地址：0.0.0.0 表示允许外部访问（若前面挂了本机 Nginx/Caddy，可改为 127.0.0.1）
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Docker 宿主机端口绑定地址（默认 0.0.0.0 避免直接访问 IP:8000 连不上；挂本机反代可改为 127.0.0.1）
BIND_HOST=0.0.0.0

# ---------- 安全与限制（可选） ----------
# 单个 Patch 最大字节数（默认 10 MiB = 10485760）
MAX_PATCH_BYTES=10485760

# 单次 git 命令超时时间（秒）
GIT_TIMEOUT_SECONDS=120

# 禁止 Patch 修改的路径（不填则使用默认值，拦截 CI 配置等敏感目录）
# 逗号分隔；设为 none 表示完全不拦截（不推荐）
# BLOCKED_PATCH_PATHS=.github/workflows/*,.github/workflows/**,.github/actions/*,.github/actions/**
# BLOCKED_PATCH_PATHS=none

# ---------- 临时文件目录（可选） ----------
# 所有 bare clone / worktree / patch 文件都落在这里，请求结束立即删除（零本地持久化）
# 不填则用系统临时目录：/tmp/git-gateway (Linux/macOS) 或 %TEMP%\git-gateway (Windows)
# TEMP_DIR=/tmp/git-gateway
